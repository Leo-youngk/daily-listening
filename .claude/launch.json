{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "app-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--prefix",
        "app",
        "--",
        "--port",
        "5180",
        "--strictPort"
      ],
      "port": 5180,
      "autoPort": false
    },
    {
      "name": "ui-concepts",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-m", "http.server", "5190", "--bind", "127.0.0.1", "--directory", "output/ui-concepts"],
      "port": 5190,
      "autoPort": false
    }
  ]
}
